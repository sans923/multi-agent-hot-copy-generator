# =============================================
# 环境变量模板文件
# 使用方法：复制此文件为 .env，填入真实值
# =============================================

# --- 应用基础配置 ---
APP_NAME="多智能体热点爆款文案生成系统"
APP_VERSION="1.0.0"
DEBUG=true
PORT=8000

# --- 智能体编排引擎 ---
# native    = 自研顺序流水线（默认）
# langgraph = LangGraph StateGraph 主流程图
ORCHESTRATION_ENGINE=native

# --- 编排模式 ---
# fixed   = 固定三阶段顺序（默认）
# agentic = 任务分级 + Plan&Execute（简单走 fixed，复杂走规划执行）
# lead    = Lead Agent 总控 + SubAgent 委派
ORCHESTRATION_MODE=fixed
# 单机 durable LangGraph checkpoint 文件；多 worker/生产环境需改用共享后端
LANGGRAPH_CHECKPOINT_PATH=./data/langgraph-checkpoints.sqlite3

# --- 多模型路由（留空则均回退 DEEPSEEK_CHAT_MODEL）---
# PLANNER_MODEL=deepseek-chat
# EXECUTOR_MODEL=deepseek-chat
# PATTERN_MODEL=deepseek-chat
# JUDGE_MODEL=deepseek-chat

# --- Agentic 编排参数 ---
# TASK_SIMPLE_MAX_WORDS=300
# AGENT_MAX_STEPS=20
# AGENT_TIMEOUT_SEC=300
# MAX_RETRY_PER_STEP=2
# MAX_REFLECT_ROUNDS=2
# ENABLE_JUDGE_VERIFY=true

# --- 全链路审计（orchestration_audit_logs 表）---
# 任务详情页「执行轨迹」+ GET /api/v1/logs/audit?task_id=
# MySQL 迁移：scripts/migrate_audit_logs.sql

# --- MySQL 数据库（默认）---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=copygen
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=copy_generator
# 若需完整连接串（优先级高于上面 MYSQL_*），取消注释：
# DATABASE_URL=mysql+pymysql://copygen:change-this-app-password@127.0.0.1:3306/copy_generator?charset=utf8mb4
# 仅本地调试可临时改回 SQLite：
# DATABASE_URL=sqlite:///./data/app.db

# --- JWT 鉴权配置 ---
SECRET_KEY=your-super-secret-key-change-this-in-production-32chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- DeepSeek API 配置 ---
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_CONNECT_TIMEOUT=15
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=4096

# --- ChromaDB 配置 ---
CHROMA_PERSIST_PATH=./data/chroma

# --- 头条长文 RAG（LangChain + LangGraph，可选）---
# TOUTIAO_RAG_COLLECTION=toutiao_references
# RAG_CHUNK_SIZE=600
# RAG_CHUNK_OVERLAP=80
# RAG_TOP_K=3

# --- 辅助发布 / 抖音 H5 用户确认投稿（可选）---
# 需先在抖音开放平台获批 h5.share、open.get.ticket；新版客户端投稿还需 aweme.share。
# Client Secret 只能保存在服务端，禁止使用 VITE_* 暴露到前端。
DOUYIN_H5_SHARE_ENABLED=false
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_API_BASE_URL=https://open.douyin.com
DOUYIN_HTTP_TIMEOUT_SECONDS=10
# 仅允许项目自有对象存储/CDN 域名，多个域名用英文逗号分隔；留空时抖音投稿保持阻断。
DOUYIN_MEDIA_ALLOWED_HOSTS=cdn.example.com

# --- 热榜 API 配置（聚合数据）---
JUHE_API_KEY=your-juhe-api-key-here
JUHE_HOTLIST_URL=https://apis.juhe.cn/fapigx/networkhot/query
HOTLIST_SYNC_INTERVAL=3600

# --- 日志配置 ---
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
