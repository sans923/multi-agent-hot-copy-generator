# =============================================
# 环境变量模板文件
# 使用方法：复制此文件为 .env，填入真实值
# .env 文件不能提交到 git（已在 .gitignore 中排除）
# =============================================

# --- 应用基础配置 ---
APP_NAME="多智能体热点爆款文案生成系统"
APP_VERSION="1.0.0"
DEBUG=true
# 服务监听端口
PORT=8000

# --- 数据库配置 ---
# 开发环境用 SQLite（文件型数据库，无需安装，路径相对于项目根目录）
DATABASE_URL=sqlite:///./data/app.db
# 生产环境切换为 MySQL（取消注释，注释掉上面的SQLite行）
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname

# --- JWT 鉴权配置 ---
# 用 openssl rand -hex 32 生成，必须修改，不能用这个示例值！
SECRET_KEY=your-super-secret-key-change-this-in-production-32chars-min
# JWT 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT 算法（固定用HS256即可）
ALGORITHM=HS256

# --- 大模型 API 配置 ---
# 火山方舟 Coding Plan API Key。请填入真实值，不要提交 .env。
LLM_API_KEY=your-ark-api-key-here
# 火山方舟 Coding Plan 的 OpenAI 兼容协议地址
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# 文案生成/Agent 使用的聊天模型
LLM_CHAT_MODEL=glm-5.2

# --- 向量化 API 配置 ---
# glm-5.2 是聊天/编程模型，不要用作 Embedding；向量化请单独配置。
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=deepseek-embedding

# --- ChromaDB 配置 ---
# 向量库存储路径（相对于项目根目录）
CHROMA_PERSIST_PATH=./data/chroma

# --- 热榜 API 配置 ---
# 韩小韩免费热榜API，无需Key
HAN_API_BASE_URL=https://api.vvhan.com/api
# 热榜数据更新间隔（秒），3600 = 1小时
HOTLIST_SYNC_INTERVAL=3600

# --- 日志配置 ---
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log
